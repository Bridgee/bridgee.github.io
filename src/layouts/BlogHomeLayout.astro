---
import BlogLayout from './BlogLayout.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<BlogLayout title={title} currentPage="blog" showHeader={true}>
  <slot />
  
  <!-- Blog Home specific styles -->
  <style>
    /* Core Modules Section Styling */
    .core-modules-container {
      background: #f8f9fa;
      padding: 1rem;
      border-radius: 8px;
      margin-bottom: 1rem;
    }

    .core-modules-title {
      color: #2c3e50;
      margin-bottom: 0.2rem;
      font-size: 1.1rem;
      font-weight: 600;
    }

    .core-modules-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 0.25rem;
    }

    .module-title {
      margin-bottom: 0.1rem;
      font-size: 1rem;
      font-weight: 600;
    }

    .module-sensing {
      color: #27ae60;
    }

    .module-behavior {
      color: #e74c3c;
    }

    .module-system {
      color: #3498db;
    }

    .module-description {
      font-size: 0.9rem;
      color: #666;
      line-height: 1.5;
    }

    /* Creative Cards Grid Layout */
    .creative-cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: 1.5rem;
      margin-top: 1rem;
    }

    /* Dark Mode Styles */
    body.dark-mode .core-modules-container {
      background: #2a2a2a;
    }

    body.dark-mode .core-modules-title {
      color: #fff;
    }

    body.dark-mode .module-sensing {
      color: #2ecc71;
    }

    body.dark-mode .module-behavior {
      color: #e67e22;
    }

    body.dark-mode .module-system {
      color: #64b5f6;
    }

    body.dark-mode .module-description {
      color: #ccc;
    }

    /* Core Modules Mobile Responsiveness */
    @media (max-width: 768px) {
      .core-modules-grid {
        gap: 0.15rem;
        grid-template-columns: 1fr;
      }
      
      .module-title {
        margin-bottom: 0.05rem;
        font-size: 0.95rem;
      }
      
      .module-description {
        font-size: 0.85rem;
        line-height: 1.4;
        margin-bottom: 0.5rem;
      }

      .creative-cards-grid {
        grid-template-columns: 1fr;
        gap: 1rem;
      }
    }

    @media (max-width: 480px) {
      .core-modules-grid {
        gap: 0.1rem;
      }
      
      .module-title {
        margin-bottom: 0.05rem;
        font-size: 0.9rem;
      }
      
      .module-description {
        font-size: 0.8rem;
        line-height: 1.3;
        margin-bottom: 0.25rem;
      }

      .creative-cards-grid {
        gap: 0.75rem;
      }
    }
  </style>

  <!-- Blog Home specific scripts -->
  <script>
    // Framework image theme switching
    function updateFrameworkImage() {
      const frameworkImage = document.getElementById('framework-image');
      if (frameworkImage) {
        const isDarkMode = document.body.classList.contains('dark-mode');
        frameworkImage.src = isDarkMode 
          ? '/images/research_framework_dark.png' 
          : '/images/research_framework.png';
      }
    }

    // Initial image update on page load
    document.addEventListener('DOMContentLoaded', () => {
      updateFrameworkImage();
    });

    // Listen for theme changes and update image
    document.addEventListener('click', (event) => {
      if (event.target.id === 'theme-toggle' || event.target.closest('#theme-toggle')) {
        // Small delay to ensure theme class is updated
        setTimeout(updateFrameworkImage, 50);
      }
    });

    // Also listen for storage changes (in case theme is changed in another tab)
    window.addEventListener('storage', (event) => {
      if (event.key === 'theme') {
        setTimeout(updateFrameworkImage, 50);
      }
    });
  </script>
</BlogLayout>