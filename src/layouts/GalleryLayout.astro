---
import BlogLayout from './BlogLayout.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<BlogLayout title={title} currentPage="gallery">
  <slot />
  
  <!-- Gallery-specific styles -->
  <style>
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 2.5rem;
      margin: 3rem 0;
      padding: 0 0.5rem;
    }

    /* Responsive breakpoints matching BlogLayout */
    @media (max-width: 1024px) {
      .gallery-grid {
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
      }
    }

    @media (max-width: 768px) {
      .gallery-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }
    }

    @media (max-width: 480px) {
      .gallery-grid {
        gap: 1rem;
        padding: 0;
      }
    }
    
    .photo-card {
      background: #f8f9fa;
      border: 1px solid #eee;
      border-radius: 8px;
      padding: 1rem;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .photo-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    }
    
    .photo-preview {
      width: 100%;
      height: 200px;
      background: #e9ecef;
      border-radius: 4px;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3rem;
      color: #6c757d;
      cursor: pointer;
    }
    
    .photo-title {
      font-size: 1.1rem;
      font-weight: 600;
      color: #2c3e50;
      margin-bottom: 0.5rem;
    }
    
    .photo-description {
      color: #666;
      font-size: 0.9rem;
      line-height: 1.5;
    }
    
    .flickr-link {
      display: inline-block;
      margin-top: 1.5rem;
      padding: 0.8rem 1.5rem;
      background: #ff1493;
      color: white;
      text-decoration: none;
      border-radius: 4px;
      font-weight: 500;
      transition: background 0.3s ease;
    }
    
    .flickr-link:hover {
      background: #e6127a;
    }
    
    /* Dark mode for gallery cards */
    :global(body.dark-mode) .photo-card {
      background: #2a2a2a;
      border-color: #333;
    }
    
    :global(body.dark-mode) .photo-title {
      color: #fff;
    }
    
    :global(body.dark-mode) .photo-description {
      color: #aaa;
    }
    
    :global(body.dark-mode) .photo-preview {
      background: #3a3a3a;
    }
  </style>
</BlogLayout>