---
import Navigation from '../components/Navigation.astro';
import FixedControls from '../components/FixedControls.astro';
import ProfileImage from '../components/ProfileImage.astro';
import Icon from '../components/Icon.astro';
import { modeConfig, personal, research, siteConfig } from "../data/index.js";

// Import blog CSS architecture
import '../css/blog/base.css';
import '../css/blog/components.css';
import '../css/blog/responsive.css';

interface Props {
  title: string;
  currentPage?: string;
  showHeader?: boolean;
  showBackButton?: boolean;
  backButtonTarget?: string;
}

const { 
  title, 
  currentPage, 
  showHeader = true, 
  showBackButton = false, 
  backButtonTarget = '' 
} = Astro.props;
---

<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={siteConfig.description}>
  <link rel="icon" href="/website_icon.png">
</head>

<body class="dark-mode">
{showHeader && (
    <div class="header-container">
      <!-- Header Section -->
      <header class="header">
        <ProfileImage size="large" variant="header" />
        <h1 class="name">{personal.identity.displayName}</h1>
        <p class="title">{personal.currentRole.headline}</p>
        <div class="contact-links">
          <a href={`mailto:${personal.contact.email}`}><Icon src="/images/icons/email_icon.png" size="1.3em" />Email</a>
          {personal.academicProfiles.map(profile => (
            <a href={profile.url} target="_blank" rel="noopener noreferrer">
              <Icon src={profile.iconSrc} emoji={profile.icon} fallback={profile.icon} size="1.3em" />{profile.label}
            </a>
          ))}
          <a href={personal.links.haitsLab} target="_blank" rel="noopener noreferrer"><Icon emoji="🧠" size="1.3em" />{research.lab.shortName}</a>
          <a href={personal.links.youtubePlaylist} target="_blank" rel="noopener noreferrer"><Icon src="/images/icons/youtube_icon.png" size="1.3em" />YouTube</a>
          <a href={personal.links.cv} target="_blank" rel="noopener noreferrer"><Icon src="/images/icons/cv_icon.png" size="1.3em" />CV</a>
        </div>
      </header>
    </div>
  )}

  <!-- Navigation -->
  <Navigation currentPage={currentPage} />

  <!-- Fixed Controls -->
  <FixedControls
    showGameLink={true}
    showBackButton={showBackButton}
    backButtonTarget={backButtonTarget}
  />

  <div class="container">
    <!-- Page Content Slot -->
    <slot />

    <!-- Footer -->
    <footer style="text-align: center; margin-top: 4rem; padding-top: 2rem; border-top: 1px solid #eee; color: #999; font-size: 0.9rem;">
      <p>© 2026 {personal.identity.displayName} • Last updated: {siteConfig.lastUpdated}</p>
      <p style="margin-top: 0.5rem;">
        <a href={modeConfig.interactive.path} style="color: #3498db; text-decoration: none;"><Icon src={modeConfig.interactive.icon} size="2.4em" /> Experience the site in {modeConfig.interactive.label}</a>
      </p>
    </footer>
  </div>
</body>
</html>
