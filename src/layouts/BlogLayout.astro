---
import Navigation from '../components/Navigation.astro';
import FixedControls from '../components/FixedControls.astro';
import ProfileImage from '../components/ProfileImage.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  currentPage?: string;
}

const { title, currentPage } = Astro.props;
---

<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <link rel="icon" href="/website_icon.png">
  <style>
    /* Professional Academic Styling */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      line-height: 1.6;
      color: #333;
      background: #fff;
      transition: all 0.3s ease;
    }
    
    /* Dark Mode */
    body.dark-mode {
      color: #e0e0e0;
      background: #1a1a1a;
    }
    
    body.dark-mode .header {
      border-bottom-color: #333;
    }
    
    body.dark-mode .name {
      color: #fff;
    }
    
    body.dark-mode .title {
      color: #aaa;
    }
    
    body.dark-mode .contact-links a {
      color: #64b5f6;
      border-color: #64b5f6;
    }
    
    body.dark-mode .contact-links a:hover {
      background: #64b5f6;
      color: #1a1a1a;
    }
    
    body.dark-mode .section-title {
      color: #fff;
      border-bottom-color: #64b5f6;
    }
    
    body.dark-mode .research-card {
      background: #2a2a2a;
      border-color: #333;
    }
    
    body.dark-mode .research-card h3 {
      color: #fff;
    }
    
    body.dark-mode .research-card p {
      color: #ccc;
    }
    
    body.dark-mode .skill-item {
      background: #2a2a2a;
    }
    
    body.dark-mode .skill-item strong {
      color: #fff;
    }
    
    body.dark-mode .publication {
      border-bottom-color: #333;
    }
    
    body.dark-mode .publication-title {
      color: #fff;
    }
    
    body.dark-mode .publication-details {
      color: #aaa;
    }
    
    /* Project Cards */
    .project-card {
      border-left: 4px solid #3498db;
      transition: transform 0.3s ease, border-color 0.3s ease;
    }
    
    .project-card:hover {
      transform: translateY(-3px);
      border-left-color: #2980b9;
    }
    
    .project-meta {
      margin: 1.5rem 0;
      display: flex;
      gap: 0.3rem;
      flex-wrap: wrap;
      align-items: center;
    }
    
    .project-tag {
      background: #ecf0f1;
      color: #2c3e50;
      padding: 0.3rem 0.6rem;
      font-size: 0.75rem;
      border-radius: 12px;
      font-weight: 500;
    }
    
    body.dark-mode .project-tag {
      background: #34495e;
      color: #ecf0f1;
    }
    
    .project-btn {
      background: #3498db;
      color: white;
      border: none;
      padding: 0.6rem 1.2rem;
      border-radius: 6px;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.3s ease;
      font-size: 0.9rem;
    }
    
    .project-btn:hover {
      background: #2980b9;
      transform: translateY(-1px);
    }
    
    body.dark-mode .project-btn {
      background: #64b5f6;
      color: #1a1a1a;
    }
    
    body.dark-mode .project-btn:hover {
      background: #42a5f5;
    }
    
    /* Dark mode for research philosophy and roadmap boxes */
    body.dark-mode div[style*="background: #f8f9fa"] {
      background: #2a2a2a !important;
    }
    
    body.dark-mode h3[style*="color: #2c3e50"],
    body.dark-mode h4[style*="color: #3498db"] {
      color: #fff !important;
    }
    
    body.dark-mode p[style*="color: #666"],
    body.dark-mode ul[style*="color: #666"] {
      color: #ccc !important;
    }
    
    body.dark-mode footer {
      border-top-color: #333;
      color: #888;
    }
    
    .container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 2rem 1rem;
    }
    
    /* Header */
    .header {
      text-align: center;
      margin-bottom: 3rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid #eee;
    }
    
    /* Profile image styles now handled by ProfileImage component */
    
    .name {
      font-size: 2.5rem;
      font-weight: 300;
      margin-bottom: 0.5rem;
      color: #2c3e50;
    }
    
    .title {
      font-size: 1.2rem;
      color: #7f8c8d;
      margin-bottom: 1rem;
    }
    
    .contact-links {
      display: flex;
      justify-content: center;
      gap: 2rem;
      flex-wrap: wrap;
      margin-top: 1rem;
    }
    
    .contact-links a {
      color: #3498db;
      text-decoration: none;
      font-size: 0.9rem;
      padding: 0.5rem 1rem;
      border: 1px solid #3498db;
      border-radius: 4px;
      transition: all 0.3s ease;
    }
    
    .contact-links a:hover {
      background: #3498db;
      color: white;
    }
    
    /* Sections */
    .section {
      margin-bottom: 3rem;
    }
    
    .section-title {
      font-size: 1.8rem;
      font-weight: 600;
      color: #2c3e50;
      margin-bottom: 1.5rem;
      border-bottom: 2px solid #3498db;
      padding-bottom: 0.5rem;
    }
    
    .about-content {
      font-size: 1.1rem;
      line-height: 1.7;
      margin-bottom: 2rem;
    }
    
    .research-interests {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 2.5rem;
      margin: 3rem 0;
      padding: 0 0.5rem;
    }
    
    .research-card {
      padding: 1.5rem;
      border: 1px solid #eee;
      border-radius: 8px;
      background: #f8f9fa;
    }
    
    .research-card h3 {
      color: #2c3e50;
      margin-bottom: 1rem;
      font-size: 1.2rem;
    }
    
    .research-card p {
      color: #666;
      line-height: 1.6;
    }
    
    .skills-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin: 2rem 0;
    }
    
    .skill-item {
      padding: 1rem;
      background: #f8f9fa;
      border-radius: 4px;
      text-align: center;
    }
    
    .skill-item strong {
      color: #2c3e50;
    }
    
    /* Publications */
    .publication {
      margin-bottom: 1.5rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid #eee;
    }
    
    .publication:last-child {
      border-bottom: none;
    }
    
    .publication-title {
      font-weight: 600;
      color: #2c3e50;
      margin-bottom: 0.5rem;
    }
    
    .publication-details {
      color: #666;
      font-size: 0.9rem;
    }
    
    /* Roadmap styling */
    .roadmap-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
      margin-top: 1rem;
    }
    
    .roadmap-phase {
      padding: 1rem;
      background: rgba(52, 152, 219, 0.05);
      border-radius: 8px;
      border-left: 3px solid #3498db;
    }
    
    .phase-title {
      color: #3498db;
      margin-bottom: 0.8rem;
      font-size: 1.1rem;
      font-weight: 600;
    }
    
    .phase-list {
      line-height: 1.8;
      color: #555;
      padding-left: 1.2rem;
      margin: 0;
    }
    
    .phase-list li {
      margin-bottom: 0.5rem;
    }
    
    /* Dark mode roadmap styling */
    :global(body.dark-mode) .roadmap-phase {
      background: rgba(52, 152, 219, 0.1);
      border-left-color: #64b5f6;
    }
    
    :global(body.dark-mode) .phase-title {
      color: #64b5f6;
    }
    
    :global(body.dark-mode) .phase-list {
      color: #ccc;
    }

    /* Responsive breakpoints: 1024px (tablet), 768px (mobile), 480px (small mobile) */
    @media (max-width: 1024px) {
      .research-interests {
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
      }
    }

    @media (max-width: 768px) {
      .container {
        padding: 1rem;
      }
      
      .name {
        font-size: 2rem;
      }
      
      .contact-links {
        gap: 1rem;
      }
      
      .research-interests {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }
      
      .roadmap-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }
    }

    @media (max-width: 480px) {
      .container {
        padding: 0.5rem;
      }
      
      .name {
        font-size: 1.5rem;
      }
      
      .contact-links {
        gap: 0.5rem;
      }
      
      .contact-links a {
        padding: 0.4rem 0.8rem;
        font-size: 0.8rem;
      }
      
      .research-interests {
        gap: 1rem;
        padding: 0;
      }
    }
  </style>
</head>

<body>
  <!-- Fixed Controls -->
  <FixedControls showGameLink={true} />

  <div class="container">
    <!-- Header Section -->
    <header class="header">
      <ProfileImage size="large" variant="header" />
      <h1 class="name">Zhouqiao (Bridge) Zhao</h1>
      <p class="title">Postdoctoral Associate • MIT Center for Transportation & Logistics • AgeLab</p>
      <div class="contact-links">
        <a href="mailto:zhouqiao@mit.edu"><Icon emoji="📧" />Email</a>
        <a href="https://scholar.google.com/citations?user=Y1s8cw0AAAAJ&hl" target="_blank"><Icon src="/images/icons/google_scholar_icon.svg" />Google Scholar</a>
        <a href="https://www.researchgate.net/profile/Zhouqiao-Zhao" target="_blank"><Icon src="/images/icons/research_gate_icon.png" />Research Gate</a>
        <a href="https://www.linkedin.com/in/zhouqiao-zhao-60560a56/" target="_blank"><Icon src="/images/icons/linkedin_icon.svg" />LinkedIn</a>
        <a href="https://ctl.mit.edu/about/bio/zhouqiao-bridge-zhao" target="_blank"><Icon src="/images/icons/mit_icon.jpg" />Lab Website</a>
        <a href="/doc/Zhouqiao_Zhao_Resume_2025_Jul.pdf" target="_blank"><Icon emoji="📄" />CV</a>
      </div>
    </header>
  </div>

  <!-- Navigation -->
  <Navigation currentPage={currentPage} />

  <div class="container">
    <!-- Page Content Slot -->
    <slot />

    <!-- Footer -->
    <footer style="text-align: center; margin-top: 4rem; padding-top: 2rem; border-top: 1px solid #eee; color: #999; font-size: 0.9rem;">
      <p>© 2025 Zhouqiao (Bridge) Zhao • Last updated: August 2025</p>
      <p style="margin-top: 0.5rem;">
        <a href="/game" style="color: #3498db; text-decoration: none;">🎮 Experience Interactive Digital Twin</a>
      </p>
    </footer>
  </div>
</body>
</html>