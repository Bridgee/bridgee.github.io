---
import BlogLayout from './BlogLayout.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<BlogLayout title={title} currentPage="music" showHeader={false} showBackButton={true} backButtonTarget="creative">
  <div class="music-root">
    <slot />
  </div>
  
  <!-- Music-specific styles -->
  <style>
    /* Grid layout for tracks - GLOBAL because it's used by slotted content */
    :global(.track-grid) {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 2.5rem;
      margin: 3rem 0;
      padding: 0 0.5rem;
    }

    /* SoundCloud embed container - GLOBAL because it's used by slotted content */
    :global(.track-embed-container) {
      margin-bottom: 1rem;
      height: auto;
    }

    /* Track description styling - GLOBAL because it's used by slotted content */
    :global(.track-description) {
      color: #666;
      font-size: 0.95rem;
      line-height: 1.6;
      margin: 0;
    }

    /* SoundCloud link styling - GLOBAL because it's used by slotted content */
    :global(.soundcloud-link) {
      display: inline-block;
      color: #3498db !important;
      text-decoration: none;
      font-weight: 500;
      transition: color 0.3s ease;
    }

    :global(.soundcloud-link:hover) {
      color: #2980b9 !important;
    }

    /* Section styling - GLOBAL because it's used by slotted content */
    :global(.about-music) {
      margin-top: 3rem;
    }

    /* Dark mode support - GLOBAL because it targets slotted content */
    :global(body.dark-mode .track-description) {
      color: #aaa;
    }

    :global(body.dark-mode .soundcloud-link) {
      color: #64b5f6 !important;
    }

    :global(body.dark-mode .soundcloud-link:hover) {
      color: #42a5f5 !important;
    }

    /* Responsive breakpoints - GLOBAL because they target slotted content */
    @media (max-width: 1024px) {
      :global(.track-grid) {
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
      }
    }

    @media (max-width: 768px) {
      :global(.track-grid) {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }
    }

    @media (max-width: 480px) {
      :global(.track-grid) {
        gap: 1rem;
        padding: 0;
      }
    }
  </style>
</BlogLayout>