---
interface Props {
  title?: string;
  variant?: 'about' | 'research' | 'publications' | 'projects' | 'creative' | 'contact';
  class?: string;
}

const { 
  title, 
  variant = 'default', 
  class: className = '' 
} = Astro.props;
---

<div class={`subsection-module subsection-module-${variant} ${className}`}>
  {title && <h4 class="module-title">{title}</h4>}
  <slot />
</div>

<style>
  /* Base module styling - maintains current core-modules styling */
  .subsection-module {
    background: #f8f9fa;
    padding: 1rem;
    border-radius: 8px;
    margin-bottom: 1rem;
  }
  
  .module-title {
    color: #2c3e50;
    margin-bottom: 0.1rem;
    font-size: 1.1rem;
    font-weight: 600;
  }
  
  /* Dark mode support */
  :global(body.dark-mode) .subsection-module {
    background: #2a2a2a;
  }
  
  :global(body.dark-mode) .module-title {
    color: #fff;
  }

  /* Mobile responsiveness */
  @media (max-width: 768px) {
    .subsection-module {
      padding: 0.5rem;
      margin-bottom: 0.5rem;
      border-radius: 4px;
    }
    
    .module-title {
      font-size: 1rem;
      margin-bottom: 0.25rem;
    }
  }

  @media (max-width: 480px) {
    .subsection-module {
      padding: 0.25rem;
      margin-bottom: 0.25rem;
      border-radius: 3px;
      background: #fafbfc;
    }
    
    .module-title {
      font-size: 0.9rem;
      margin-bottom: 0.15rem;
    }
  }

  /* Dark mode mobile adjustments */
  @media (max-width: 480px) {
    :global(body.dark-mode) .subsection-module {
      background: #1f1f1f;
    }
  }
</style>