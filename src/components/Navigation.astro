---
import { navigationConfig } from '../js/data/navigation.js';

interface Props {
  currentPage?: string;
}

const { currentPage } = Astro.props;
---

<nav class="nav">
  <div class="nav-container">
    <!-- Section links - always show, but modify links for non-blog pages -->
    {navigationConfig.sections.map(section => (
      <a href={currentPage === 'blog' ? section.href : `/blog${section.href}`} 
         class={currentPage === 'blog' && section.href === '#about' ? 'active' : ''}>
        {section.label}
      </a>
    ))}
    
    <!-- External page links - always show all pages -->
    {navigationConfig.pages
      .filter(page => page.section === 'pages')
      .map(page => (
        <a href={page.href} class={currentPage === page.href.replace('/', '') ? 'active' : ''}>
          {page.label}
        </a>
      ))}
      
    <!-- Contact link - always at the end -->
    {navigationConfig.contact.map(contact => (
      <a href={currentPage === 'blog' ? contact.href : `/blog${contact.href}`} 
         class={currentPage === 'blog' && contact.href === '#contact' ? 'active' : ''}>
        {contact.label}
      </a>
    ))}
  </div>
</nav>

<style>
  /* Sticky Navigation */
  .nav {
    position: sticky;
    top: 0;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    z-index: 100;
    padding: 1rem 0;
    margin-bottom: 2rem;
    border-bottom: 1px solid #eee;
  }

  .nav-container {
    display: flex;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .nav a {
    color: #2c3e50;
    text-decoration: none;
    font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    transition: background 0.3s ease;
  }

  .nav a:hover, 
  .nav a.active {
    background: #ecf0f1;
  }

  /* Dark mode support */
  :global(body.dark-mode) .nav {
    background: rgba(26, 26, 26, 0.95);
    border-bottom-color: #333;
  }

  :global(body.dark-mode) .nav a {
    color: #fff;
  }

  :global(body.dark-mode) .nav a:hover, 
  :global(body.dark-mode) .nav a.active {
    background: #333;
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .nav {
      padding: 0.8rem 0;
      margin-bottom: 1.5rem;
    }

    .nav-container {
      gap: 1rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .nav a {
      padding: 0.4rem 0.8rem;
      font-size: 0.9rem;
    }
  }

  @media (max-width: 480px) {
    .nav {
      padding: 0.6rem 0;
    }

    .nav-container {
      gap: 0.5rem;
    }

    .nav a {
      padding: 0.3rem 0.6rem;
      font-size: 0.8rem;
    }
  }
</style>

<script>
  // Smooth scrolling for navigation
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }
      });
    });

    // Update active navigation item on scroll
    window.addEventListener('scroll', () => {
      const sections = document.querySelectorAll('.section');
      const navLinks = document.querySelectorAll('.nav a');
      
      let current = '';
      sections.forEach(section => {
        const sectionTop = section.offsetTop;
        const sectionHeight = section.clientHeight;
        if (pageYOffset >= sectionTop - 200) {
          current = section.getAttribute('id');
        }
      });

      navLinks.forEach(link => {
        link.classList.remove('active');
        if (link.getAttribute('href') === `#${current}`) {
          link.classList.add('active');
        }
      });
    });
  });
</script>