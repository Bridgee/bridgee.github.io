---
import GameLayout from "../layouts/GameLayout.astro";
import { gameData, modeConfig } from "../data/index.js";

interface WorldPoint { top: string; left: string; }
interface WorldArea extends WorldPoint { width: string; height: string; }

const pixels = (value: string | number) => Number.parseFloat(String(value));
const targetOffset = (targetSize: number, visualSize: number) => (targetSize - visualSize) / 2;
const npcOffset = targetOffset(gameData.entities.npc.targetSize, gameData.entities.npc.visualSize);
const collectibleOffset = targetOffset(gameData.entities.collectible.targetSize, gameData.entities.collectible.visualSize);
const minimapStyle = (position: WorldArea) => {
  const scaleX = gameData.world.minimap.width / gameData.world.width;
  const scaleY = gameData.world.minimap.height / gameData.world.height;
  return `top: ${pixels(position.top) * scaleY}px; left: ${pixels(position.left) * scaleX}px; width: ${pixels(position.width) * scaleX}px; height: ${pixels(position.height) * scaleY}px;`;
};
const minimapMarkerStyle = (position: WorldPoint, color: string) => {
  const scaleX = gameData.world.minimap.width / gameData.world.width;
  const scaleY = gameData.world.minimap.height / gameData.world.height;
  const markerSize = gameData.world.minimap.markerSize;
  return `top: ${pixels(position.top) * scaleY}px; left: ${pixels(position.left) * scaleX}px; width: ${markerSize}px; height: ${markerSize}px; background-color: var(--npc-${color});`;
};
---
<GameLayout>
    <!-- Loading Screen -->
    <div id="loading-screen">
        <div class="loading-text">LOADING WORLD...</div>
    </div>

    <!-- Game Container -->
    <div id="game-container">
        <!-- Game World -->
        <div id="game-world" style={`width: ${gameData.world.width}px; height: ${gameData.world.height}px;`}>
            <!-- Dynamic Areas -->
            {Object.entries(gameData.areas).map(([id, area]) => (
              <div id={id} class="game-area" role="button" tabindex="0" aria-label={`Open ${area.label}`} style={`top: ${area.position.top}; left: ${area.position.left}; width: ${area.position.width}; height: ${area.position.height};`}>
                <div class="area-label">{area.label}</div>
                <div class="area-icon" role="img" aria-label={area.label} set:html={area.icon} />
                <!-- 8-bit pixel architecture -->
                <div class={`area-architecture ${id.replace('-area', '')}-building`}>
                  {Array.from({ length: 64 }).map(() => <div class="building-pixel"></div>)}
                </div>
              </div>
            ))}

            <!-- Decorative collision geometry is rendered from the shared world configuration. -->
            {gameData.fences.map(fence => (
              <div
                class={`fence ${fence.orientation}`}
                aria-hidden="true"
                style={`top: ${fence.y}px; left: ${fence.x}px; width: ${fence.width}px; height: ${fence.height}px;`}
              />
            ))}

            <!-- Dynamic NPCs -->
            {gameData.npcs.map(npc => (
              <div class={`npc color-${npc.color}`} role="button" tabindex="0" aria-label={`Talk to ${npc.name}`} style={`top: ${pixels(npc.position.top) - npcOffset}px; left: ${pixels(npc.position.left) - npcOffset}px;`} data-name={npc.name} data-dialogue={JSON.stringify(npc.dialogue)}>
                <div class={`npc-sprite ${npc.sprite}`}>
                  {Array.from({ length: 64 }).map(() => <div class="pixel"></div>)}
                </div>
              </div>
            ))}

            <!-- Dynamic Collectibles -->
            {gameData.collectibles.map((item, index) => (
              <div class="collectible" role="button" tabindex="0" aria-label={`Collect ${item.type} item ${index + 1}`} style={`top: ${pixels(item.position.top) - collectibleOffset}px; left: ${pixels(item.position.left) - collectibleOffset}px;`} data-type={item.type} set:html={item.icon} />
            ))}
            
            <!-- Player -->
            <div id="player" style={`width: ${gameData.player.width}px; height: ${gameData.player.height}px;`}>
                <div class="player-sprite facing-down">
                    <!-- 8x8 pixel grid for character -->
                    {Array.from({ length: 64 }).map(() => <div class="pixel"></div>)}
                </div>
            </div>
        </div>
    </div>
    
    <!-- HUD -->
    <div id="hud">
        <div id="score">XP: 0</div>
        <div id="level">LEVEL: 1</div>
        <div id="achievements">🏆 0/{gameData.collectibles.length}</div>
    </div>
    
    <!-- Instructions -->
    <div id="instructions">
        <strong>Instructions:</strong><br><br>
        🎮 Move: WASD/Arrows/Pad<br>
        💬 Interact: SPACE/Click/◎<br>
        🚪 Close popup: ESC/Click X<br><br>

        🎯 Get close to interact<br>
        ⭐ Gain XP by exploring<br>
        🏆 Unlock achievements<br>
    </div>
    
    <!-- Interaction Prompt -->
    <div id="interaction-prompt" class="interaction-prompt">
        Press SPACE or ◎ to interact
    </div>
    
    <!-- Dialogue Box -->
    <div id="dialogue-box" class="dialogue-box">
        <div class="dialogue-speaker" id="dialogue-speaker">Speaker</div>
        <div class="dialogue-text" id="dialogue-text">Dialogue text here...</div>
        <div class="dialogue-continue">Press SPACE or ◎ to continue...</div>
    </div>
    
    <!-- Minimap -->
    <div id="minimap" role="img" aria-label="Map of interactive areas, characters, and the player" style={`width: ${gameData.world.minimap.width}px; height: ${gameData.world.minimap.height}px;`}>
        {Object.values(gameData.areas).map(area => (
          <div class="minimap-area" aria-hidden="true" style={minimapStyle(area.position)} />
        ))}
        {gameData.npcs.map(npc => (
          <div class="minimap-npc" aria-hidden="true" style={minimapMarkerStyle(npc.position, npc.color)} />
        ))}
        <div id="minimap-player"></div>
    </div>
    
    <!-- Mobile Controls -->
    <div id="mobile-controls">
        <div class="control-pad">
            <button class="control-btn" id="btn-up" data-dir="up" type="button" aria-label="Move up"></button>
            <button class="control-btn" id="btn-down" data-dir="down" type="button" aria-label="Move down"></button>
            <button class="control-btn" id="btn-left" data-dir="left" type="button" aria-label="Move left"></button>
            <button class="control-btn" id="btn-right" data-dir="right" type="button" aria-label="Move right"></button>
        </div>
        <button class="control-btn" id="btn-action" type="button" aria-label="Interact or continue">◎</button>
    </div>
    
    <!-- Achievement Notification -->
    <div id="achievement" class="achievement" role="status" aria-live="polite" aria-atomic="true" hidden>
        <div id="achievement-text">ACHIEVEMENT UNLOCKED!</div>
    </div>
    
    <!-- Switch Mode Button -->
    <a id="switch-mode-btn" href={modeConfig.portfolio.path}>📝 {modeConfig.portfolio.label}</a>

    <!-- Popups for different areas -->
    <div id="popup" class="popup" role="dialog" aria-modal="true" aria-label="Game area details">
        <button class="popup-close" type="button" aria-label="Close popup">&times;</button>
        <div id="popup-content" class="popup-content"></div>
    </div>
    
</GameLayout>
