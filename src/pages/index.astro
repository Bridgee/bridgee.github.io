---
import ProfileImage from '../components/ProfileImage.astro';
import Icon from '../components/Icon.astro';

// Import shared CSS for theme consistency
import '../css/blog/base.css';
import '../css/blog/components.css';
---

<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zhouqiao (Bridge) Zhao - Digital Playground</title>
    <link rel="icon" href="/website_icon.png">
    <style>
      /* Override base.css body styles for index page */
      body {
        background: linear-gradient(135deg, #e3f2fd 0%, #f3e5f5 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      /* Dark Mode */
      body.dark-mode {
        background: linear-gradient(135deg, #2c3e50 0%, #1a1a1a 100%);
      }

      .container {
        max-width: 1000px;
        width: 100%;
        padding: 3rem 2rem;
        text-align: center;
      }

      .hero-section {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border-radius: 20px;
        padding: 3rem;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        margin-bottom: 2rem;
        transition: all 0.3s ease;
      }

      body.dark-mode .hero-section {
        background: rgba(42, 42, 42, 0.95);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
      }

      /* Profile avatar styles now handled by ProfileImage component */

      .main-title {
        font-size: 2.5rem;
        font-weight: 300;
        margin-bottom: 0.5rem;
        color: #2c3e50;
      }

      body.dark-mode .main-title {
        color: #fff;
      }

      .subtitle {
        font-size: 1.2rem;
        color: #2c3e50;
        margin-bottom: 2rem;
      }

      body.dark-mode .subtitle {
        color: #aaa;
      }

      .intro-text {
        font-size: 1.1rem;
        line-height: 1.7;
        color: #2c3e50;
        margin-bottom: 3rem;
        max-width: 800px;
        margin-left: auto;
        margin-right: auto;
      }

      body.dark-mode .intro-text {
        color: #ccc;
      }

      .mode-selection {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        margin-top: 3rem;
      }

      .mode-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border-radius: 15px;
        padding: 2rem;
        text-decoration: none;
        color: inherit;
        transition: all 0.3s ease;
        border: 2px solid rgba(102, 126, 234, 0.3);
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.15);
        position: relative;
        overflow: hidden;
      }

      .mode-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(102, 126, 234, 0.1), transparent);
        transition: all 0.3s ease;
      }

      .mode-card:hover::before {
        left: 100%;
      }

      body.dark-mode .mode-card {
        background: rgba(42, 42, 42, 0.95);
        border-color: rgba(100, 181, 246, 0.3);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
      }

      body.dark-mode .mode-card::before {
        background: linear-gradient(90deg, transparent, rgba(100, 181, 246, 0.1), transparent);
      }

      .mode-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        border-color: #667eea;
        background: rgba(255, 255, 255, 1);
      }

      body.dark-mode .mode-card:hover {
        border-color: #64b5f6;
        background: rgba(50, 50, 50, 1);
        box-shadow: 0 20px 40px rgba(100, 181, 246, 0.1);
      }

      .mode-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
        display: block;
      }

      .mode-title {
        font-size: 1.4rem;
        font-weight: 600;
        margin-bottom: 1rem;
        color: #2c3e50;
      }

      body.dark-mode .mode-title {
        color: #fff;
      }

      .mode-description {
        font-size: 0.95rem;
        line-height: 1.6;
        color: #666;
      }

      body.dark-mode .mode-description {
        color: #ccc;
      }

      /* Override theme toggle styles for index page */
      .theme-toggle {
        position: fixed;
        bottom: 1rem;
        right: 1rem;
        background: rgba(52, 152, 219, 0.95) !important;
        color: white !important;
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
        border-radius: 50px !important;
        padding: 0.6rem 1rem !important;
        font-size: 0.8rem !important;
        cursor: pointer !important;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2) !important;
        transition: all 0.3s ease !important;
        backdrop-filter: blur(15px) !important;
        z-index: 1001 !important;
        white-space: nowrap !important;
        font-weight: 500 !important;
      }

      body.dark-mode .theme-toggle {
        background: rgba(42, 42, 42, 0.95) !important;
        color: white !important;
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
      }

      .theme-toggle:hover {
        transform: translateY(-2px) !important;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15) !important;
      }

      @media (max-width: 768px) {
        .container {
          padding: 2rem 1rem;
        }

        .hero-section {
          padding: 2rem;
        }

        .main-title {
          font-size: 2rem;
        }

        .mode-selection {
          grid-template-columns: 1fr;
          gap: 1.5rem;
        }

      }

      @media (max-width: 480px) {

        .hero-section {
          padding: 1.5rem;
        }

        .container {
          padding: 1rem 0.5rem;
        }
      }
    </style>
  </head>
  <body class="dark-mode">
    <button class="theme-toggle" id="theme-toggle">☀️ Light</button>
    
    <div class="container">
      <div class="mode-selection-intro">
        <ProfileImage size="medium" variant="avatar" />
        <h1 class="main-title">Zhouqiao (Bridge) Zhao</h1>
        <p class="subtitle">Postdoctoral Associate • MIT Center for Transportation & Logistics • AgeLab</p>
        
        <div class="intro-text">
          <p>
            Welcome! I'm Bridge, a postdoctoral researcher at MIT.
          </p>
          
          <p style="margin-top: 1.5rem;">
            I'm an Electrical and Computer Engineer working at the intersection of Human-Centered AI, Connected and Automated Vehicles (CAV), and Intelligent Transportation Systems (ITS). 
          </p>

          <p style="margin-top: 1.5rem;">
            I'm also a photographer and music enthusiast.
          </p>

          <p style="margin-top: 1.5rem;">
            This site is my digital playground—explore my research, creative projects, and etc., in either portfolio mode or an interactive 8-bit world:
          </p>
        </div>

        <div class="mode-selection">
          <a href="/blog" class="mode-card" id="blogBtn">
            <span class="mode-icon"><Icon src="/images/icons/portfolio_icon.png" /></span>
            <h3 class="mode-title"> Portfolio Mode</h3>
            <p class="mode-description">Browse my portfolio in a clean and traditional format.</p>
          </a>
          
          <a href="/game" class="mode-card" id="gameBtn">
            <span class="mode-icon"><Icon src="/images/icons/game_mode_icon.png" /></span>
            <h3 class="mode-title">Interactive Mode</h3>
            <p class="mode-description">Explore my world as an 8-bit adventure!</p>
          </a>
        </div>
      </div>
    </div>

    <script is:inline>
      // Inline theme management for index page compatibility
      function toggleTheme() {
        try {
          document.body.classList.toggle('dark-mode');
          const isDark = document.body.classList.contains('dark-mode');
          const toggleBtn = document.getElementById('theme-toggle');
          if (toggleBtn) {
            toggleBtn.textContent = isDark ? '☀️ Light' : '🌙 Dark';
          }
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        } catch (error) {
          console.error('Theme toggle error:', error);
        }
      }

      function initializeTheme() {
        try {
          const savedTheme = localStorage.getItem('theme');
          const toggleBtn = document.getElementById('theme-toggle');
          
          if (savedTheme === 'light') {
            document.body.classList.remove('dark-mode');
            if (toggleBtn) {
              toggleBtn.textContent = '🌙 Dark';
            }
          } else {
            document.body.classList.add('dark-mode');
            if (toggleBtn) {
              toggleBtn.textContent = '☀️ Light';
            }
            if (!savedTheme) {
              localStorage.setItem('theme', 'dark');
            }
          }
          
          if (toggleBtn) {
            toggleBtn.addEventListener('click', toggleTheme);
          }
        } catch (error) {
          console.error('Theme initialization error:', error);
        }
      }

      // Initialize theme and set up event listeners
      document.addEventListener('DOMContentLoaded', () => {
        initializeTheme();

        // Store mode preference when clicking mode cards
        document.querySelectorAll('.mode-card').forEach(card => {
          card.addEventListener('click', () => {
            localStorage.setItem('prefMode', card.getAttribute('href'));
          });
        });
      });
    </script>
  </body>
</html>