<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zhouqiao (Bridge) Zhao - Digital Playground</title>
    <link rel="icon" href="/favicon.svg">
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #333;
        transition: all 0.3s ease;
      }

      /* Dark Mode */
      body.dark-mode {
        background: linear-gradient(135deg, #2c3e50 0%, #1a1a1a 100%);
        color: #e0e0e0;
      }

      .container {
        max-width: 1000px;
        width: 100%;
        padding: 3rem 2rem;
        text-align: center;
      }

      .hero-section {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border-radius: 20px;
        padding: 3rem;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        margin-bottom: 2rem;
        transition: all 0.3s ease;
      }

      body.dark-mode .hero-section {
        background: rgba(42, 42, 42, 0.95);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
      }

      .profile-avatar {
        width: 120px;
        height: 120px;
        background: linear-gradient(135deg, #667eea, #764ba2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
        margin: 0 auto 2rem;
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
      }

      body.dark-mode .profile-avatar {
        background: linear-gradient(135deg, #64b5f6, #42a5f5);
        box-shadow: 0 10px 30px rgba(100, 181, 246, 0.3);
      }

      .main-title {
        font-size: 2.5rem;
        font-weight: 300;
        margin-bottom: 0.5rem;
        color: #2c3e50;
      }

      body.dark-mode .main-title {
        color: #fff;
      }

      .subtitle {
        font-size: 1.2rem;
        color: #7f8c8d;
        margin-bottom: 2rem;
      }

      body.dark-mode .subtitle {
        color: #aaa;
      }

      .intro-text {
        font-size: 1.1rem;
        line-height: 1.7;
        color: #555;
        margin-bottom: 3rem;
        max-width: 800px;
        margin-left: auto;
        margin-right: auto;
      }

      body.dark-mode .intro-text {
        color: #ccc;
      }

      .mode-selection {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        margin-top: 3rem;
      }

      .mode-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 15px;
        padding: 2rem;
        text-decoration: none;
        color: inherit;
        transition: all 0.3s ease;
        border: 2px solid rgba(102, 126, 234, 0.3);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
        position: relative;
        overflow: hidden;
      }

      .mode-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(102, 126, 234, 0.1), transparent);
        transition: all 0.3s ease;
      }

      .mode-card:hover::before {
        left: 100%;
      }

      body.dark-mode .mode-card {
        background: rgba(42, 42, 42, 0.95);
        border-color: rgba(100, 181, 246, 0.3);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
      }

      body.dark-mode .mode-card::before {
        background: linear-gradient(90deg, transparent, rgba(100, 181, 246, 0.1), transparent);
      }

      .mode-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        border-color: #667eea;
        background: rgba(255, 255, 255, 1);
      }

      body.dark-mode .mode-card:hover {
        border-color: #64b5f6;
        background: rgba(50, 50, 50, 1);
        box-shadow: 0 20px 40px rgba(100, 181, 246, 0.1);
      }

      .mode-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
        display: block;
      }

      .mode-title {
        font-size: 1.4rem;
        font-weight: 600;
        margin-bottom: 1rem;
        color: #2c3e50;
      }

      body.dark-mode .mode-title {
        color: #fff;
      }

      .mode-description {
        font-size: 0.95rem;
        line-height: 1.6;
        color: #666;
      }

      body.dark-mode .mode-description {
        color: #ccc;
      }

      .theme-toggle {
        position: fixed;
        bottom: 1rem;
        right: 1rem;
        background: rgba(52, 152, 219, 0.95);
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 50px;
        padding: 0.6rem 1rem;
        font-size: 0.8rem;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
        transition: all 0.3s ease;
        backdrop-filter: blur(15px);
        z-index: 1001;
        white-space: nowrap;
      }

      body.dark-mode .theme-toggle {
        background: rgba(42, 42, 42, 0.95);
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.2);
      }

      .theme-toggle:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
      }

      @media (max-width: 1024px) {
        .theme-toggle {
          bottom: 0.8rem;
          right: 0.8rem;
          padding: 0.5rem 0.8rem;
          font-size: 0.75rem;
        }
      }

      @media (max-width: 768px) {
        .container {
          padding: 2rem 1rem;
        }

        .hero-section {
          padding: 2rem;
        }

        .main-title {
          font-size: 2rem;
        }

        .mode-selection {
          grid-template-columns: 1fr;
          gap: 1.5rem;
        }

        .theme-toggle {
          bottom: 0.5rem;
          right: 0.5rem;
          padding: 0.4rem 0.6rem;
          font-size: 0.7rem;
          border-radius: 40px;
        }
      }

      @media (max-width: 480px) {
        .theme-toggle {
          bottom: 0.3rem;
          right: 0.3rem;
          padding: 0.3rem 0.5rem;
          font-size: 0.65rem;
          border-radius: 30px;
        }

        .hero-section {
          padding: 1.5rem;
        }

        .container {
          padding: 1rem 0.5rem;
        }
      }
    </style>
  </head>
  <body>
    <button class="theme-toggle" onclick="toggleTheme()" id="theme-toggle">🌙 Dark</button>
    
    <div class="container">
      <div class="hero-section">
        <div class="profile-avatar">👨‍🔬</div>
        <h1 class="main-title">Zhouqiao (Bridge) Zhao</h1>
        <p class="subtitle">Postdoctoral Associate • MIT Center for Transportation & Logistics</p>
        
        <div class="intro-text">
          <p>Welcome to my digital playground! I'm a researcher exploring the fascinating intersection of artificial intelligence, transportation systems, and human-centered design at MIT.</p>
          
          <p style="margin-top: 1.5rem;">Beyond academia, I'm a creative technologist who captures the world through photography and expresses ideas through electronic music composition. This site reflects my interdisciplinary approach - combining serious research with playful, interactive design.</p>
        </div>

        <div class="mode-selection">
          <a href="/game" class="mode-card" id="gameBtn">
            <span class="mode-icon">🎮</span>
            <h3 class="mode-title">Interactive Digital Twin</h3>
            <p class="mode-description">Explore my world as an 8-bit adventure! Navigate through research labs, photo galleries, and music studios. Talk to NPCs, collect XP, and discover my work through an immersive gaming experience.</p>
          </a>
          
          <a href="/blog" class="mode-card" id="blogBtn">
            <span class="mode-icon">📝</span>
            <h3 class="mode-title">Academic Portfolio</h3>
            <p class="mode-description">Browse my professional academic portfolio with research publications, project details, photography gallery, and music compositions in a clean, traditional academic format.</p>
          </a>
        </div>
      </div>
    </div>

    <script>
      // Theme Toggle - Enhanced with error handling
      window.toggleTheme = function() {
        try {
          document.body.classList.toggle('dark-mode');
          const isDark = document.body.classList.contains('dark-mode');
          const toggleBtn = document.getElementById('theme-toggle');
          if (toggleBtn) {
            toggleBtn.textContent = isDark ? '☀️ Light' : '🌙 Dark';
          }
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        } catch (error) {
          console.error('Theme toggle error:', error);
        }
      };

      // Load saved theme
      document.addEventListener('DOMContentLoaded', () => {
        try {
          const savedTheme = localStorage.getItem('theme');
          if (savedTheme === 'dark') {
            document.body.classList.add('dark-mode');
            const toggleBtn = document.getElementById('theme-toggle');
            if (toggleBtn) {
              toggleBtn.textContent = '☀️ Light';
            }
          }
        } catch (error) {
          console.error('Theme loading error:', error);
        }
      });

      // Store mode preference
      document.querySelectorAll('.mode-card').forEach(card => {
        card.addEventListener('click', () => {
          localStorage.setItem('prefMode', card.getAttribute('href'));
        });
      });
    </script>
  </body>
</html>