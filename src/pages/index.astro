<html lang="en">
  <body style="display:flex;flex-direction:column;align-items:center;
               justify-content:center;height:100vh;font-family:sans-serif;gap:2rem;">
    <h1>Welcome to Zhouqiao Zhao’s Site</h1>
    <a id="gameBtn" href="/game" style="font-size:1.4rem;">🎮 Game Mode</a>
    <a id="blogBtn" href="/blog" style="font-size:1.4rem;">📝 Blog Mode</a>

    <script>
      document.querySelectorAll('a').forEach(a =>
        a.addEventListener('click', () =>
          localStorage.setItem('prefMode', a.getAttribute('href')),
        ),
      );
      const last = localStorage.getItem('prefMode');
      if (last && location.pathname === '/') location.href = last;
    </script>
  </body>
</html>