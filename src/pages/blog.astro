---
import { gameData } from "../js/data.js";
---

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zhouqiao (Bridge) Zhao - MIT Postdoc Researcher</title>
    <link rel="icon" href="/favicon.svg">
    <style>
        /* Professional Academic Styling */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            line-height: 1.6;
            color: #333;
            background: #fff;
            transition: all 0.3s ease;
        }
        
        /* Dark Mode */
        body.dark-mode {
            color: #e0e0e0;
            background: #1a1a1a;
        }
        
        body.dark-mode .header {
            border-bottom-color: #333;
        }
        
        body.dark-mode .name {
            color: #fff;
        }
        
        body.dark-mode .title {
            color: #aaa;
        }
        
        body.dark-mode .contact-links a {
            color: #64b5f6;
            border-color: #64b5f6;
        }
        
        body.dark-mode .contact-links a:hover {
            background: #64b5f6;
            color: #1a1a1a;
        }
        
        body.dark-mode .nav a {
            color: #fff;
        }
        
        body.dark-mode .nav a:hover, body.dark-mode .nav a.active {
            background: #333;
        }
        
        body.dark-mode .section-title {
            color: #fff;
            border-bottom-color: #64b5f6;
        }
        
        body.dark-mode .research-card {
            background: #2a2a2a;
            border-color: #333;
        }
        
        body.dark-mode .research-card h3 {
            color: #fff;
        }
        
        body.dark-mode .research-card p {
            color: #ccc;
        }
        
        body.dark-mode .skill-item {
            background: #2a2a2a;
        }
        
        body.dark-mode .skill-item strong {
            color: #fff;
        }
        
        body.dark-mode .publication {
            border-bottom-color: #333;
        }
        
        body.dark-mode .publication-title {
            color: #fff;
        }
        
        body.dark-mode .publication-details {
            color: #aaa;
        }
        
        body.dark-mode footer {
            border-top-color: #333;
            color: #888;
        }
        
        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 2rem 1rem;
        }
        
        /* Header */
        .header {
            text-align: center;
            margin-bottom: 3rem;
            padding-bottom: 2rem;
            border-bottom: 1px solid #eee;
        }
        
        .profile-image {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            margin-bottom: 1rem;
            background: #f0f0f0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 48px;
            margin-left: auto;
            margin-right: auto;
        }
        
        .name {
            font-size: 2.5rem;
            font-weight: 300;
            margin-bottom: 0.5rem;
            color: #2c3e50;
        }
        
        .title {
            font-size: 1.2rem;
            color: #7f8c8d;
            margin-bottom: 1rem;
        }
        
        .contact-links {
            display: flex;
            justify-content: center;
            gap: 2rem;
            flex-wrap: wrap;
            margin-top: 1rem;
        }
        
        .contact-links a {
            color: #3498db;
            text-decoration: none;
            font-size: 0.9rem;
            padding: 0.5rem 1rem;
            border: 1px solid #3498db;
            border-radius: 4px;
            transition: all 0.3s ease;
        }
        
        .contact-links a:hover {
            background: #3498db;
            color: white;
        }
        
        /* Navigation (updated above for sticky) */
        
        .nav a {
            color: #2c3e50;
            text-decoration: none;
            font-weight: 500;
            padding: 0.5rem 1rem;
            border-radius: 4px;
            transition: background 0.3s ease;
        }
        
        .nav a:hover, .nav a.active {
            background: #ecf0f1;
        }
        
        /* Sections */
        .section {
            margin-bottom: 3rem;
        }
        
        .section-title {
            font-size: 1.8rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 1.5rem;
            border-bottom: 2px solid #3498db;
            padding-bottom: 0.5rem;
        }
        
        .about-content {
            font-size: 1.1rem;
            line-height: 1.7;
            margin-bottom: 2rem;
        }
        
        .research-interests {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-bottom: 2rem;
        }
        
        .research-card {
            padding: 1.5rem;
            border: 1px solid #eee;
            border-radius: 8px;
            background: #f8f9fa;
        }
        
        .research-card h3 {
            color: #2c3e50;
            margin-bottom: 1rem;
            font-size: 1.2rem;
        }
        
        .research-card p {
            color: #666;
            line-height: 1.6;
        }
        
        .skills-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin: 2rem 0;
        }
        
        .skill-item {
            padding: 1rem;
            background: #f8f9fa;
            border-radius: 4px;
            text-align: center;
        }
        
        .skill-item strong {
            color: #2c3e50;
        }
        
        /* Fixed Controls */
        .fixed-controls {
            position: fixed;
            top: 2rem;
            right: 2rem;
            z-index: 1000;
            display: flex;
            gap: 1rem;
        }
        
        .mode-switch a, .theme-toggle {
            background: #3498db;
            color: white;
            padding: 0.75rem 1.5rem;
            border-radius: 25px;
            text-decoration: none;
            font-weight: 500;
            box-shadow: 0 2px 10px rgba(52, 152, 219, 0.3);
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
            font-size: 0.9rem;
        }
        
        .mode-switch a:hover, .theme-toggle:hover {
            background: #2980b9;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(52, 152, 219, 0.4);
        }
        
        body.dark-mode .mode-switch a, body.dark-mode .theme-toggle {
            background: #64b5f6;
            color: #1a1a1a;
        }
        
        body.dark-mode .mode-switch a:hover, body.dark-mode .theme-toggle:hover {
            background: #42a5f5;
        }
        
        /* Sticky Navigation */
        .nav {
            position: sticky;
            top: 0;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            z-index: 100;
            padding: 1rem 0;
            margin-bottom: 2rem;
            border-bottom: 1px solid #eee;
        }
        
        body.dark-mode .nav {
            background: rgba(26, 26, 26, 0.95);
            border-bottom-color: #333;
        }
        
        /* Publications */
        .publication {
            margin-bottom: 1.5rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid #eee;
        }
        
        .publication:last-child {
            border-bottom: none;
        }
        
        .publication-title {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 0.5rem;
        }
        
        .publication-details {
            color: #666;
            font-size: 0.9rem;
        }
        
        /* Responsive */
        @media (max-width: 768px) {
            .container {
                padding: 1rem;
            }
            
            .name {
                font-size: 2rem;
            }
            
            .contact-links {
                gap: 1rem;
            }
            
            .nav {
                gap: 1rem;
            }
            
            .mode-switch {
                top: 1rem;
                right: 1rem;
            }
        }
    </style>
</head>

<body>
