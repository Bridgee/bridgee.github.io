---
import MusicLayout from '../layouts/MusicLayout.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import { personal } from "../data/index.js";
---

<MusicLayout title="Musics & Sound Design - Zhouqiao (Bridge) Zhao">
    
    <!-- Music & Sound Design Section -->
    <section class="section">
        <h2 class="section-title">Musics & Sound Design</h2>
        
        <div class="track-grid">
            {personal.media.music.tracks.map(track => (
                <Card variant="track" icon="🎵" title={track.title}>
                    <!-- SoundCloud Embed -->
                    <div class="track-embed-container">
                        <iframe 
                            width="100%"
                            height="300" 
                            scrolling="no"
                            frameborder="no"
                            allow="autoplay" 
                            src={`https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/tracks/${track.id}&color=%23ff5500&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true&visual=true`}
                        />

                        <div 
                            style="font-size: 10px; color: #cccccc;line-break: anywhere;word-break: normal;overflow: hidden;white-space: nowrap;text-overflow: ellipsis; font-family: Interstate,Lucida Grande,Lucida Sans Unicode,Lucida Sans,Garuda,Verdana,Tahoma,sans-serif;font-weight: 100;">
                            <a href={personal.links.soundcloud} title="BridgeZhao" target="_blank" style="color: #cccccc; text-decoration: none;">
                                BridgeZhao
                            </a> · 
                            <a href={track.link} title={track.title} target="_blank" style="color: #cccccc; text-decoration: none;">
                                {track.title}
                            </a>
                        </div>
                    </div>

                    <p class="track-description">{track.description}</p>

                    <p style="margin-top: 1rem;">
                        <a href={track.link} target="_blank" class="soundcloud-link">
                            <strong>Listen on SoundCloud →</strong>
                        </a>
                    </p>
                </Card>
            ))}
        </div>
        
        <!-- About My Music Section -->
        <div class="about-music">
            <Card variant="track" icon="🎧" title="About My Music">
                <p>I'm a composer, sound designer, and music synthesizer designer/experimenter who leverages my EE background in signal processing and circuit design. Sound design and synthesis fascinate me because they represent the perfect fusion of technical precision and creative expression.</p>

                <p>My electrical engineering foundation gives me a deep understanding of how signals flow through circuits, filters shape frequencies, and oscillators generate the building blocks of sound. This technical knowledge allows me to approach synthesis not just as a user, but as someone who truly understands what's happening under the hood.</p>

                <p>Whether I'm designing custom patches, experimenting with modular synthesis, or crafting soundscapes, I'm always exploring the boundaries between the mathematical beauty of signal processing and the emotional impact of music.</p>
                
                <p style="margin-top: 1rem;">
                    <a href={personal.links.soundcloud} target="_blank" class="soundcloud-link">
                        <strong><Icon src="/images/icons/sound_cloud.svg"/> Explore Full Discography on SoundCloud →</strong>
                    </a>
                </p>
            </Card>
        </div>
    </section>

</MusicLayout>