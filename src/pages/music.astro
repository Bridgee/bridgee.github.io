---
import MusicLayout from '../layouts/MusicLayout.astro';
import Card from '../components/Card.astro';
import { personal } from "../data/index.js";
import Icon from '../components/Icon.astro';
---

<MusicLayout title="Music & Sound Design - Zhouqiao (Bridge) Zhao">
    <!-- Music & Sound Design Section -->
    <section class="section">
        <h2 class="section-title">Music & Sound Design</h2>

        <div class="about-content">
            <p></p>
        </div>
        
        <!-- Featured Tracks Section -->
        <h3 style="font-size: 1.5rem; margin: 2rem 0 1.5rem; color: #2c3e50;">Featured Tracks</h3>
        
        <div class="track-grid">
            {personal.media.music.tracks.map(track => (
                <Card variant="track" icon="🎵" title={track.title}>
                    <!-- SoundCloud Embed -->
                    <div class="track-embed-container" style="margin-bottom: 1rem; height: auto;">
                    </div>

                    <p class="track-description">{track.description}</p>

                    <p style="margin-top: 1rem;">
                        <a href={`${track.link}`} target="_blank" style="color: #3498db;"></a>
                            <strong>Listen on SoundCloud →</strong>
                        </a>
                    </p>
                </Card>
            ))}
        </div>
        
        <!-- About My Music Section -->
        <Card variant="track" icon="🎧" title="About My Music">
            <p>My electronic music compositions explore the intersection of technology and creativity, often drawing inspiration from my research in complex systems and AI. Each track is an experiment in sound design, utilizing synthesizers and digital processing to create immersive sonic landscapes.</p>

            <p>The creative process often parallels my scientific work - both involve systematic exploration, hypothesis testing, and iterative refinement to achieve desired outcomes.</p>
            
            <p style="margin-top: 1rem;">
                <a href="https://soundcloud.com/zhouqiao-zhao" target="_blank" class="soundcloud-link" style="color: #3498db;">
                    <strong><Icon src="/images/icons/sound_cloud.svg"/> Explore Full Discography on SoundCloud →</strong>
                </a>
            </p>
        </Card>
    </section>
</MusicLayout>