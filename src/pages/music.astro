---
import MusicLayout from '../layouts/MusicLayout.astro';
import Card from '../components/ui/Card.astro';
import { gameData } from "../js/data.js";
---

<MusicLayout title="Music & Sound Design - Zhouqiao (Bridge) Zhao">
    <!-- Music & Sound Design Section -->
    <section class="section">
        <h2 class="section-title">Music & Sound Design</h2>
        <div class="about-content">
            <p>Electronic compositions exploring the intersection of technology and creativity</p>
        </div>
        
        <!-- Featured Tracks Section -->
        <h3 style="font-size: 1.5rem; margin: 2rem 0 1.5rem; color: #2c3e50;">Featured Tracks</h3>
            <div class="track-grid">
                {gameData.media.music.tracks.map(track => (
                    <Card variant="track" 
                          icon="🎵" 
                          title={track.title}
                          href={`https://soundcloud.com/zhouqiao-zhao/tracks`}
                          target="_blank">
                        <p><strong>Duration:</strong> {track.duration}</p>
                        <p style="margin-top: 1rem;">
                            <strong style="color: #3498db;">Listen on SoundCloud →</strong>
                        </p>
                    </Card>
                ))}
            </div>
            
            <Card variant="track" icon="🎧" title="About My Music">
                <p>
                    My electronic music compositions explore the intersection of technology and creativity, often drawing inspiration from my research in complex systems and AI. Each track is an experiment in sound design, utilizing synthesizers and digital processing to create immersive sonic landscapes.
                </p>
                <p style="margin-top: 1rem;">
                    The creative process often parallels my scientific work - both involve systematic exploration, hypothesis testing, and iterative refinement to achieve desired outcomes.
                </p>
            </Card>
            
            <p style="text-align: center; margin-top: 2rem;">
                <a href="https://soundcloud.com/zhouqiao-zhao" target="_blank" 
                   style="color: #3498db; text-decoration: none; font-weight: 500; font-size: 1.1rem;">
                   ☁️ Explore Full Discography on SoundCloud →
                </a>
            </p>
    </section>
</MusicLayout>