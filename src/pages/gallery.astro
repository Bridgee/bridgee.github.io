---
import { gameData } from "../js/data.js";
---

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Photography Gallery - Zhouqiao (Bridge) Zhao</title>
    <link rel="icon" href="/favicon.svg">
    <style>
        /* Professional Academic Styling */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            line-height: 1.6;
            color: #333;
            background: #fff;
            transition: all 0.3s ease;
        }
        
        /* Dark Mode */
        body.dark-mode {
            color: #e0e0e0;
            background: #1a1a1a;
        }
        
        body.dark-mode .header {
            border-bottom-color: #333;
        }
        
        body.dark-mode .name {
            color: #fff;
        }
        
        body.dark-mode .title {
            color: #aaa;
        }
        
        body.dark-mode .nav a {
            color: #fff;
        }
        
        body.dark-mode .nav a:hover, body.dark-mode .nav a.active {
            background: #333;
        }
        
        body.dark-mode .section-title {
            color: #fff;
            border-bottom-color: #64b5f6;
        }
        
        body.dark-mode .photo-card {
            background: #2a2a2a;
            border-color: #333;
        }
        
        body.dark-mode .photo-card h3 {
            color: #fff;
        }
        
        body.dark-mode .photo-card p {
            color: #ccc;
        }
        
        body.dark-mode footer {
            border-top-color: #333;
            color: #888;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem 1rem;
        }
        
        /* Header */
        .header {
            text-align: center;
            margin-bottom: 3rem;
            padding-bottom: 2rem;
            border-bottom: 1px solid #eee;
        }
        
        .name {
            font-size: 2rem;
            font-weight: 300;
            margin-bottom: 0.5rem;
            color: #2c3e50;
        }
        
        .title {
            font-size: 1rem;
            color: #7f8c8d;
            margin-bottom: 1rem;
        }
        
        /* Fixed Controls */
        .fixed-controls {
            position: fixed;
            top: 2rem;
            right: 2rem;
            z-index: 1000;
            display: flex;
            gap: 1rem;
        }
        
        .nav-link, .theme-toggle {
            background: #3498db;
            color: white;
            padding: 0.75rem 1.5rem;
            border-radius: 25px;
            text-decoration: none;
            font-weight: 500;
            box-shadow: 0 2px 10px rgba(52, 152, 219, 0.3);
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
            font-size: 0.9rem;
        }
        
        .nav-link:hover, .theme-toggle:hover {
            background: #2980b9;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(52, 152, 219, 0.4);
        }
        
        body.dark-mode .nav-link, body.dark-mode .theme-toggle {
            background: #64b5f6;
            color: #1a1a1a;
        }
        
        body.dark-mode .nav-link:hover, body.dark-mode .theme-toggle:hover {
            background: #42a5f5;
        }
        
        /* Navigation */
        .nav {
            position: sticky;
            top: 0;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            z-index: 100;
            padding: 1rem 0;
            margin-bottom: 2rem;
            border-bottom: 1px solid #eee;
        }
        
        body.dark-mode .nav {
            background: rgba(26, 26, 26, 0.95);
            border-bottom-color: #333;
        }
        
        .nav a {
            color: #2c3e50;
            text-decoration: none;
            font-weight: 500;
            padding: 0.5rem 1rem;
            border-radius: 4px;
            transition: background 0.3s ease;
        }
        
        .nav a:hover, .nav a.active {
            background: #ecf0f1;
        }
        
        /* Sections */
        .section {
            margin-bottom: 3rem;
        }
        
        .section-title {
            font-size: 1.8rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 1.5rem;
            border-bottom: 2px solid #3498db;
            padding-bottom: 0.5rem;
        }
        
        .photo-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 2rem;
            margin-bottom: 2rem;
        }
        
        .photo-card {
            padding: 1.5rem;
            border: 1px solid #eee;
            border-radius: 8px;
            background: #f8f9fa;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        
        .photo-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }
        
        .photo-card h3 {
            color: #2c3e50;
            margin-bottom: 1rem;
            font-size: 1.2rem;
        }
        
        .photo-card p {
            color: #666;
            line-height: 1.6;
            margin-bottom: 0.5rem;
        }
        
        .photo-link {
            color: #3498db;
            text-decoration: none;
            font-weight: 500;
        }
        
        .photo-link:hover {
            text-decoration: underline;
        }
        
        .photo-placeholder {
            width: 100%;
            height: 200px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            margin-bottom: 1rem;
            color: white;
        }
        
        /* Responsive */
        @media (max-width: 768px) {
            .container {
                padding: 1rem;
            }
            
            .fixed-controls {
                top: 1rem;
                right: 1rem;
                flex-direction: column;
            }
            
            .name {
                font-size: 1.5rem;
            }
            
            .photo-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <!-- Fixed Controls -->
    <div class="fixed-controls">
        <button class="theme-toggle" onclick="toggleTheme()" id="theme-toggle">🌙 Dark</button>
        <a href="/blog" class="nav-link">📝 Back to Portfolio</a>
        <a href="/game" class="nav-link">🎮 Interactive Digital Twin</a>
    </div>

    <div class="container">
        <!-- Header -->
        <header class="header">
            <h1 class="name">Photography Gallery</h1>
            <p class="title">Capturing moments between experiments and explorations</p>
        </header>

        <!-- Navigation -->
        <nav class="nav">
            <div style="display: flex; justify-content: center; gap: 2rem; flex-wrap: wrap;">
                <a href="/blog">Portfolio Home</a>
                <a href="/music">Music</a>
                <a href="/gallery" class="active">Gallery</a>
                <a href="/thoughts">Thoughts</a>
            </div>
        </nav>

        <!-- Gallery Content -->
        <section class="section">
            <h2 class="section-title">Featured Photography</h2>
            <div class="photo-grid">
                {gameData.media.photos.map(photo => (
                    <div class="photo-card">
                        <div class="photo-placeholder">{photo.emoji}</div>
                        <h3>{photo.emoji} {photo.title}</h3>
                        <p>{photo.description}</p>
                        <p style="margin-top: 1rem;">
                            <a href={`https://www.flickr.com/photos/bridgezhao/${photo.id}/`} target="_blank" 
                               class="photo-link">
                               View on Flickr →
                            </a>
                        </p>
                    </div>
                ))}
            </div>
            
            <div style="margin-top: 3rem; padding: 2rem; background: #f8f9fa; border-radius: 8px;">
                <h3 style="margin-bottom: 1rem; color: #2c3e50;">About My Photography</h3>
                <p style="line-height: 1.7; color: #666;">
                    Photography serves as both documentation and artistic expression in my life. Whether capturing the intricate details of laboratory equipment, the vast landscapes encountered during field research, or the unexpected beauty found in everyday academic life, each image tells a story of discovery.
                </p>
                <p style="line-height: 1.7; color: #666; margin-top: 1rem;">
                    My approach to photography mirrors my scientific methodology - careful observation, patient waiting for the right moment, and finding beauty in both the planned and serendipitous encounters with light, form, and meaning.
                </p>
            </div>
            
            <p style="text-align: center; margin-top: 2rem;">
                <a href="https://www.flickr.com/photos/bridgezhao/" target="_blank" 
                   style="color: #3498db; text-decoration: none; font-weight: 500; font-size: 1.1rem;">
                   🖼️ Browse Full Gallery on Flickr →
                </a>
            </p>
        </section>

        <!-- Footer -->
        <footer style="text-align: center; margin-top: 4rem; padding-top: 2rem; border-top: 1px solid #eee; color: #999; font-size: 0.9rem;">
            <p>© 2025 Zhouqiao (Bridge) Zhao • <a href="/blog" style="color: #3498db; text-decoration: none;">Portfolio Home</a></p>
        </footer>
    </div>

    <script>
        // Theme Toggle - Enhanced with error handling
        window.toggleTheme = function() {
            try {
                document.body.classList.toggle('dark-mode');
                const isDark = document.body.classList.contains('dark-mode');
                const toggleBtn = document.getElementById('theme-toggle');
                if (toggleBtn) {
                    toggleBtn.textContent = isDark ? '☀️ Light' : '🌙 Dark';
                }
                localStorage.setItem('theme', isDark ? 'dark' : 'light');
            } catch (error) {
                console.error('Theme toggle error:', error);
            }
        };

        // Load saved theme
        document.addEventListener('DOMContentLoaded', () => {
            try {
                const savedTheme = localStorage.getItem('theme');
                if (savedTheme === 'dark') {
                    document.body.classList.add('dark-mode');
                    const toggleBtn = document.getElementById('theme-toggle');
                    if (toggleBtn) {
                        toggleBtn.textContent = '☀️ Light';
                    }
                }
            } catch (error) {
                console.error('Theme loading error:', error);
            }
        });
    </script>
</body>
</html>