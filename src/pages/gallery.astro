---
import GalleryLayout from '../layouts/GalleryLayout.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import { personal } from "../data/index.js";
---

<GalleryLayout title="Photography Gallery - Zhouqiao (Bridge) Zhao">
    
    <!-- Photography Gallery Section -->
    <section class="section">
        <h2 class="section-title">Featured Photography</h2>
        
        <div class="gallery-grid">
            {personal.media.photos.map(photo => (
                <Card variant="photo" title={photo.title}>
                    <div class="photo-container">
                        <!-- Image -->
                        <img 
                            src={`/images/${photo.filename}`} 
                            alt={photo.title} 
                            class="gallery-image"
                            loading="lazy" 
                        />
                    </div>

                    <p class="photo-description">{photo.description}</p>
                    
                    <p style="margin-top: 1rem;">
                        <a href={`https://www.flickr.com/photos/bridgezhao/${photo.id}/`} target="_blank" class="flickr-link">
                            <strong>View Original on Flickr →</strong>
                        </a>
                    </p>
                </Card>
            ))}
        </div>
        
        <!-- About My Photography Section -->
        <div class="about-photography">
            <Card variant="photo" icon="📷" title="About My Photography">
                <p>Photography serves as both documentation and artistic expression in my life. Whether capturing the intricate details of laboratory equipment, the vast landscapes encountered during field research, or the unexpected beauty found in everyday academic life, each image tells a story of discovery.</p>
                
                <p>My approach to photography mirrors my scientific methodology - careful observation, patient waiting for the right moment, and finding beauty in both the planned and serendipitous encounters with light, form, and meaning.</p>
                
                <p style="margin-top: 1rem;">
                    <a href={personal.links.flickr} target="_blank" class="flickr-link">
                        <strong><Icon src="/images/icons/flickr.svg"/> Explore Full Gallery on Flickr →</strong>
                    </a>
                </p>
            </Card>
        </div>
    </section>
</GalleryLayout>