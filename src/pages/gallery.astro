---
import GalleryLayout from '../layouts/GalleryLayout.astro';
import Card from '../components/Card.astro';
import { sharedData } from "../js/data/shared.js";
---

<GalleryLayout title="Photography Gallery - Zhouqiao (Bridge) Zhao">
    <!-- Photography Gallery Section -->
    <section class="section">
        <h2 class="section-title">Featured Photography</h2>
        <div class="about-content">
            <p>Capturing moments between experiments and explorations - from laboratory details to vast research landscapes.</p>
        </div>
        
        <div class="gallery-grid">
            {sharedData.media.photos.map(photo => (
                <Card variant="photo" 
                      icon={photo.emoji} 
                      title={photo.title}
                      href={`https://www.flickr.com/photos/bridgezhao/${photo.id}/`}
                      target="_blank">
                    <div class="photo-preview" style="margin-bottom: 1rem;">{photo.emoji}</div>
                    <p class="photo-description">{photo.description}</p>
                    <p style="margin-top: 1rem;">
                        <strong style="color: #3498db;">View on Flickr →</strong>
                    </p>
                </Card>
            ))}
        </div>
        
        <Card variant="photo" icon="📷" title="About My Photography">
            <p>
                Photography serves as both documentation and artistic expression in my life. Whether capturing the intricate details of laboratory equipment, the vast landscapes encountered during field research, or the unexpected beauty found in everyday academic life, each image tells a story of discovery.
            </p>
            <p style="margin-top: 1rem;">
                My approach to photography mirrors my scientific methodology - careful observation, patient waiting for the right moment, and finding beauty in both the planned and serendipitous encounters with light, form, and meaning.
            </p>
        </Card>
        
        <p style="text-align: center; margin-top: 2rem;">
            <a href="https://www.flickr.com/photos/bridgezhao/" target="_blank" 
               class="flickr-link">
               🖼️ Browse Full Gallery on Flickr →
            </a>
        </p>
    </section>
</GalleryLayout>