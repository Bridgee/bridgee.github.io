---
import GalleryLayout from '../layouts/GalleryLayout.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import { personal, siteConfig } from "../data/index.js";
---

<GalleryLayout title={`Photography Gallery | ${siteConfig.author}`}>
    
    <!-- Photography Gallery Section -->
    <section class="section">
        <h2 class="section-title">Featured Photography</h2>
        
        <div class="gallery-grid">
            {personal.media.photos.map(photo => (
                <Card variant="photo" title={photo.title}>
                    <div class="photo-container">
                        <!-- Image -->
                        <img 
                            src={`/images/${photo.filename}`} 
                            alt={photo.title} 
                            class="gallery-image"
                            loading="lazy" 
                        />
                    </div>

                    <p class="photo-description">{photo.description}</p>
                    
                    <p style="margin-top: 1rem;">
                        <a href={`${personal.links.flickr}${photo.id}/`} target="_blank" rel="noopener noreferrer" class="flickr-link">
                            <strong>View Original on Flickr →</strong>
                        </a>
                    </p>
                </Card>
            ))}
        </div>
        
        <!-- About My Photography Section -->
        <div class="about-photography">
            <Card variant="photo" icon="📷" title="About My Photography">
                <p>Photography serves as both documentation and artistic expression in my life. I'm drawn to vintage lenses because they capture something beyond just sharp images - they capture a vibe, a mood, a feeling that modern optics often miss.</p>
                
                <p>There's something magical about the way vintage glass renders light, the subtle imperfections, the character that comes from decades of engineering history. These lenses help me see the world with a different perspective, adding warmth and soul to moments worth preserving.</p>
                
                <p style="margin-top: 1rem;">
                    <a href={personal.links.flickr} target="_blank" rel="noopener noreferrer" class="flickr-link">
                        <strong><Icon src="/images/icons/flickr.svg"/> Explore Full Gallery on Flickr →</strong>
                    </a>
                </p>
            </Card>
        </div>
    </section>
</GalleryLayout>
